  "@meSettings": {
    "description": "Row in Me. Glossary set_settings."
  },
  "quotaUsed": "{used} of {limit} used",
  "@quotaUsed": {
    "description": "Quota meter text, for example on Plan & usage.",
    "placeholders": {
      "used": {
        "type": "int",
        "format": "decimalPattern",
        "example": "9"
      },
      "limit": {
        "type": "int",
        "format": "decimalPattern",
        "example": "10"
      }
    }
  },
  "pendingChanges": "{count, plural, =0{No unsynced changes} =1{1 unsynced change} other{{count} unsynced changes}}",
  "@pendingChanges": {
    "description": "Shown when the device was signed out with local edits not yet synced (UX §3.7).",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "sessionRevokedTitle": "You’ve been signed out",
  "@sessionRevokedTitle": {
    "description": "Title of the full-screen notice when another device signed in (UX §3.7)."
  },
  "sessionRevokedBody": "Your account just signed in on {deviceModel} at {time}.",
  "@sessionRevokedBody": {
    "description": "Body of the signed-out notice. time is already formatted for the user's region.",
    "placeholders": {
      "deviceModel": {
        "type": "String",
        "example": "iPad Air"
      },
      "time": {
        "type": "String",
        "example": "9:41 PM"
      }
    }
  },
  "paywallDevices": "Plus works on your phone, tablet and computer (coming soon) at the same time.",
